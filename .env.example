APP_NAME=Banking Customer Churn Intelligence API
APP_VERSION=1.0.0
LOG_LEVEL=INFO
MODEL_PATH=ml/banking_model.pkl
BATCH_OUTPUT_DIR=backend/storage/batch_outputs
OLLAMA_BASE_URL=http://127.0.0.1:11434
# CPU-friendly small model (faster than llama3 8B). Use llama3.2:1b for even faster.
OLLAMA_MODEL=llama3.2:3b
LLM_TIMEOUT_SECONDS=90
LLM_MAX_CHARS=4000
# Fewer tokens = faster. Smaller context = less RAM and faster on CPU.
LLM_NUM_PREDICT=800
LLM_NUM_CTX=4096
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
